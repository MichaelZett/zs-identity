<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- Vaadin constructors call overridable add()/setSizeFull(); that is the
         only lifecycle hook the framework provides. -->
    <Match>
        <Class name="~.*\.ui\..*"/>
        <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/>
    </Match>

    <!-- Vaadin views are Serializable (HTTP session) but reference
         non-serializable Spring services. Session replication across several
         nodes is not in use. -->
    <Match>
        <Class name="~.*\.ui\..*"/>
        <Bug pattern="SE_BAD_FIELD,SE_BAD_FIELD_STORE,SE_NO_SERIALVERSIONID,SE_TRANSIENT_FIELD_NOT_RESTORED,SE_COMPARATOR_SHOULD_BE_SERIALIZABLE"/>
    </Match>

    <!-- Views hand out internal Vaadin components through getters; defensive
         copies would break the Vaadin binding. -->
    <Match>
        <Class name="~.*\.ui\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- JPA entities hand out collections by reference (Hibernate dirty tracking). -->
    <Match>
        <Class name="~.*\.domain\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,EQ_DOESNT_OVERRIDE_EQUALS,HE_EQUALS_USE_HASHCODE"/>
    </Match>

    <!-- DTOs and records are read-only views; a copy per call would be too expensive. -->
    <Match>
        <Class name="~.*\.values\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Entity constructors validate mandatory fields through requireNonNull,
         which is exactly what the project convention demands. The finalizer
         attack SpotBugs is worried about requires a finalizer, which none of
         these classes has. -->
    <Match>
        <Class name="~.*\.domain\..*"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Mail texts deliberately contain \n and not %n: the line break of a mail
         is laid down by RFC 5322 and must not depend on the operating
         system. -->
    <Match>
        <Class name="~.*MailSender"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>

    <!-- Generated code. -->
    <Match>
        <Source name="~.*/build/generated/.*"/>
    </Match>

    <!-- IdentityMigrations moves the tables of an installation from before
         0.8.0 with ALTER ... SET SCHEMA and cleans its rows out of the
         application's history table. Identifiers cannot be bound as
         parameters; they come from Flyway's configuration and the connection,
         never from user input, and are quoted. The values are bound. -->
    <Match>
        <Class name="de.zettsystems.identity.configuration.IdentityMigrations"/>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE,SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
    </Match>

</FindBugsFilter>
